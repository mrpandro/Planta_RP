  427     local cfg = CZCraft.Config and CZCraft.Config.Balance and CZCraft.Config.Balance.condition
  427     if type(cfg) ~= 'table' then
****0         return { max = 100, start = 100, wearPerCycle = 0.5, blockThreshold = 20 }
          end
  427     return {
  427         max = cfg.max or 100,
  427         start = cfg.start or 100,
  427         wearPerCycle = cfg.wearPerCycle or 0.5,
  427         blockThreshold = cfg.blockThreshold or 20,
  427     }
      end

      -- Reads the maintenance config for restoration amount.
      -- @return table { conditionRestoration }
      local function maintenanceConfig()
    7     local cfg = CZCraft.Config and CZCraft.Config.Balance and CZCraft.Config.Balance.maintenance
    7     if type(cfg) ~= 'table' then
****0         return { conditionRestoration = 40 }
          end
    7     return {
    7         conditionRestoration = cfg.conditionRestoration or 40,
    7     }
      end

      -- Clamps a condition level to [0, max].
      -- @param level number
      -- @param max number
      -- @return number clamped
      local function clampLevel(level, max)
  384     if level < 0 then return 0 end
  380     if level > max then return max end
  378     return level
      end

      -- Determines whether a machine has enough condition to start a new cycle.
      -- A cycle can start only when the current condition is above the block
