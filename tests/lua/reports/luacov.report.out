*****0         return { cyclesToRun = 0, blockReason = 'params must be a table', shouldContinue = false, nextChunkElapsed = 0 }
           end

    66     local recipe = params.recipe
    66     if type(recipe) ~= 'table' then
*****0         return { cyclesToRun = 0, blockReason = 'no recipe', shouldContinue = false, nextChunkElapsed = 0 }
           end

