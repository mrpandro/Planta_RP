   67     if type(cfg) ~= 'table' then
****0         return { capacity = 100, start = 100, consumptionPerCycle = 5, blockThreshold = 5, cellCharge = 50 }
          end
   67     return {
   67         capacity = cfg.capacity or 100,
   67         start = cfg.start or 100,
   67         consumptionPerCycle = cfg.consumptionPerCycle or 5,
