      -- qb-czcraft recipe snapshot (pure)
      -- Builds a deterministic canonical string and a frozen snapshot table for a
      -- recipe so an in-flight cycle is pinned to the exact inputs/outputs/duration/
      -- cost that were configured when it started. Later recipe edits do not
      -- retroactively change an in-flight cycle.
      --
      -- The canonical string is the hash pre-image; the repository computes the real
      -- SHA-256 via SQL `SHA2(?, 256)` when persisting czcraft_active_cycles.
      -- recipe_hash. This keeps shared/ side-effect-free (no native crypto) and
      -- matches the existing inject-queryFn pattern.
      --
      -- Pinned fields (the ones that affect cycle outcome):
      --   id, machine, duration, access, primaryOutput, inputs (item+amount),
      --   outputs (item+amount). The `enabled` flag is NOT pinned because pausing/
      --   disabling a recipe should stop the *next* cycle, not the in-flight one.

    2 CZCraft = CZCraft or {}

      -- Determines whether a value is a finite number.
      local function isFiniteNumber(value)
   58     return type(value) == 'number' and value == value and math.abs(value) ~= math.huge
      end

      -- Validates that a recipe has the minimum fields needed for a snapshot.
      -- @param recipe table
      -- @return boolean ok
      -- @return string|nil reason
      local function validateRecipeForSnapshot(recipe)
   59     if type(recipe) ~= 'table' then
****0         return false, 'recipe must be a table'
          end
   59     if type(recipe.id) ~= 'string' or recipe.id == '' then
    1         return false, 'recipe.id must be a nonempty string'
          end
   58     if type(recipe.machine) ~= 'string' or recipe.machine == '' then
****0         return false, 'recipe.machine must be a nonempty string'
          end
   58     if not isFiniteNumber(recipe.duration) or recipe.duration <= 0 then
    1         return false, 'recipe.duration must be a positive finite number'
          end
   57     if type(recipe.inputs) ~= 'table' or #recipe.inputs == 0 then
    1         return false, 'recipe.inputs must be a nonempty list'
          end
   56     if type(recipe.outputs) ~= 'table' or #recipe.outputs == 0 then
****0         return false, 'recipe.outputs must be a nonempty list'
          end
   56     if type(recipe.primaryOutput) ~= 'string' or recipe.primaryOutput == '' then
****0         return false, 'recipe.primaryOutput must be a nonempty string'
          end
   56     return true
      end

      -- Sorts an array of { item, amount } by item name for deterministic ordering.
      local function sortedItemLines(lines)
   70     local copy = {}
  175     for _, line in ipairs(lines) do
  105         copy[#copy + 1] = { item = line.item, amount = line.amount }
          end
  107     table.sort(copy, function(a, b) return a.item < b.item end)
   70     return copy
      end

      -- Builds the deterministic canonical string for a recipe.
      -- This is the hash pre-image: the repository computes SHA2(canonical, 256).
      -- @param recipe table
      -- @return string canonical
      -- @return string|nil error  (nil on success)
      local function canonicalRecipe(recipe)
   38     local ok, reason = validateRecipeForSnapshot(recipe)
   38     if not ok then
    3         return nil, reason
          end

   35     local parts = {}
   35     parts[#parts + 1] = 'id=' .. recipe.id
   35     parts[#parts + 1] = 'machine=' .. recipe.machine
   35     parts[#parts + 1] = 'duration=' .. tostring(recipe.duration)
   35     parts[#parts + 1] = 'access=' .. tostring(recipe.access or '')
   35     parts[#parts + 1] = 'primaryOutput=' .. recipe.primaryOutput

          -- Inputs: sorted by item name for stable ordering.
   35     local sortedInputs = sortedItemLines(recipe.inputs)
   35     local inputParts = {}
  104     for _, line in ipairs(sortedInputs) do
   69         inputParts[#inputParts + 1] = line.item .. ':' .. tostring(line.amount)
          end
   35     parts[#parts + 1] = 'inputs=' .. table.concat(inputParts, ',')

          -- Outputs: sorted by item name for stable ordering.
   35     local sortedOutputs = sortedItemLines(recipe.outputs)
