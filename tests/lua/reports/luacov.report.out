****0         return nil, { { path = 'recipes', message = 'recipes must be a table/list' } }
          end

   21     local catalog = {
   21         byId = {},
   21         byMachine = {},
   21         order = {},
          }
   21     local errors = {}

  309     for index, recipe in ipairs(recipes) do
  288         local path = 'recipes[' .. index .. ']'

  288         if type(recipe) ~= 'table' then
****0             errors[#errors + 1] = { path = path, message = 'recipe entry must be a table' }
                  goto continue
              end

  288         local id = recipe.id
  288         if type(id) ~= 'string' or id == '' then
    1             errors[#errors + 1] = { path = path .. '.id', message = 'recipe id must be a nonempty string' }
    1             goto continue
              end

              -- Detect duplicate IDs without overwriting the first entry.
  287         if catalog.byId[id] ~= nil then
    1             errors[#errors + 1] = { path = path .. '.id', message = 'duplicate recipe id: ' .. id }
    1             goto continue
              end

  286         local machine = recipe.machine
  286         if type(machine) ~= 'string' or machine == '' then
****0             errors[#errors + 1] = { path = path .. '.machine', message = 'recipe machine must be a nonempty string' }
                  goto continue
              end

  286         local entry = {
  286             index = index,
  286             recipe = recipe,
              }

  286         catalog.byId[id] = entry
  286         catalog.order[#catalog.order + 1] = id

  286         if not catalog.byMachine[machine] then
   77             catalog.byMachine[machine] = {}
              end
  286         local machineList = catalog.byMachine[machine]
  286         machineList[#machineList + 1] = entry

