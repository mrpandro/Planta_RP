*****0         return false, 'recipe.inputs must be a nonempty list'
           end
    12     if type(recipe.outputs) ~= 'table' or #recipe.outputs == 0 then
*****0         return false, 'recipe.outputs must be a nonempty list'
           end

           -- Build a stock lookup by item_name.
    12     local stockByItem = {}
    12     if type(params.stockRows) == 'table' then
    48         for _, row in ipairs(params.stockRows) do
    36             if row and row.item_name then
    36                 stockByItem[row.item_name] = {
    36                     quantity = row.quantity or 0,
    36                     reserved_quantity = row.reserved_quantity or 0,
    36                 }
