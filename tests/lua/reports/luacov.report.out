       -- qb-czcraft scheduler (pure heap + wake logic)
       -- Global min-heap of due times keyed by machine_uuid. No per-machine loops.
       -- The heap is rebuilt at startup from czcraft_machines.next_due_at. Indexed
       -- polling is a recovery safety net only.

     2 CZCraft = CZCraft or {}

       -- A binary min-heap keyed by `due_at`.
       -- Entries: { due_at = number, machine_uuid = string }
     2 local Scheduler = {}

       -- Creates a new empty heap.
       -- @return table heap
     2 function Scheduler.newHeap()
    24     return { size = 0, entries = {} }
       end

       -- Swaps two heap entries.
       local function swap(entries, i, j)
    24     entries[i], entries[j] = entries[j], entries[i]
       end

       -- Bubbles an entry up from index i.
       local function bubbleUp(entries, i)
    74     while i > 1 do
    44         local parent = math.floor(i / 2)
    44         if entries[i].due_at < entries[parent].due_at then
     8             swap(entries, i, parent)
     8             i = parent
               else
                   break
               end
           end
       end

       -- Sinks an entry down from index i.
       local function sinkDown(entries, size, i)
           while true do
    46         local left = i * 2
    46         local right = left + 1
    46         local smallest = i
    46         if left <= size and entries[left].due_at < entries[smallest].due_at then
    16             smallest = left
               end
    46         if right <= size and entries[right].due_at < entries[smallest].due_at then
     4             smallest = right
               end
    46         if smallest ~= i then
    16             swap(entries, i, smallest)
    16             i = smallest
               else
                   break
               end
           end
       end

