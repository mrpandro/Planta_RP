   120     local cycles, blockReason = CZCraft.Bills.computeCyclesForChunk({
    60         recipeDurationSeconds = recipe.duration,
    60         elapsedSeconds = elapsed,
    60         maxCyclesPerChunk = params.maxCyclesPerChunk,
    60         inputAvailability = inputAvailability,
    60         recipeInputs = recipe.inputs,
    60         outputCapacityRemaining = outputCapacityRemaining,
    60         outputWeightPerCycle = outputWeightPerCycle,
