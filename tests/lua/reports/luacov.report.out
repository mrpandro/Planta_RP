    3 function Upgrades.validatePurchase(params)
   12     local cfg = upgradesConfig()
   12     local track = cfg.tracks and cfg.tracks[params.track]
   12     if not track then
    1         return false, 'unknown track: ' .. tostring(params.track)
          end

   11     local currentLevel = params.currentLevel or 0
   11     local maxLevel = track.maxLevel or 0
   11     if currentLevel >= maxLevel then
    2         return false, 'track at max level'
          end

    9     local pointsPerLevel = track.pointsPerLevel or 1
