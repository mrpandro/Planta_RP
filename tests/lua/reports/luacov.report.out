    46         local recipe = params.recipe
    46         if state.stockRows and type(recipe.inputs) == 'table' then
    92             for _, line in ipairs(recipe.inputs) do
    46                 for _, row in ipairs(state.stockRows) do
    46                     if row.item_name == line.item then
    46                         row.quantity = row.quantity - (line.amount * result.cyclesToRun)
