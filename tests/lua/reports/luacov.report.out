    64     local lastCompletedAt = params.lastCompletedAt or 0
    64     local now = params.now or 0
    64     local elapsed = now - lastCompletedAt

           -- Zero or negative elapsed: no catch-up needed.
    64     if elapsed <= 0 then
     4         return { cyclesToRun = 0, blockReason = nil, shouldContinue = false, nextChunkElapsed = 0 }
           end

           -- Build input availability from stock rows.
    60     local inputAvailability = {}
    60     if type(params.stockRows) == 'table' then
   180         for _, row in ipairs(params.stockRows) do
   120             if row and row.item_name then
   120                 inputAvailability[row.item_name] = (row.quantity or 0) - (row.reserved_quantity or 0)
                   end
               end
           end

           -- Compute output capacity remaining.
    60     local usedWeight = params.machineUsedWeight or 0
    60     local currentReserved = params.machineReservedWeight or 0
