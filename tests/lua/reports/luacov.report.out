       -- qb-czcraft bills domain (pure)
       -- Bill creation, pause/remove semantics, and stable selection logic for
       -- PRODUCE_X and MAINTAIN_X modes. Pure so it runs under stock Lua 5.4 in tests.
       --
       -- Bill semantics (from decisions.md):
       --   PRODUCE_X: target in primary-output units, must be a multiple of the batch
       --     size; counts COMPLETED primary-output units, not current stock.
       --     Withdrawing stock never reopens a finished bill.
       --   MAINTAIN_X: compares stock + reserved output; may exceed target by at
       --     most one batch.
       --   Pause: current cycle finishes; no new cycle starts.
       --   Remove: pause + mark removed (stock/reservations unaffected).
       --   Selection: stable order by (enabled, priority, created_sequence).

     4 CZCraft = CZCraft or {}

     4 local BillMode = {
     4     PRODUCE_X = 'PRODUCE_X',
     4     MAINTAIN_X = 'MAINTAIN_X',
       }

     4 local BillStatus = {
     4     PENDING = 'PENDING',
     4     ACTIVE = 'ACTIVE',
     4     PAUSED = 'PAUSED',
     4     COMPLETED = 'COMPLETED',
     4     REMOVED = 'REMOVED',
       }

     4 local BillPriority = {
     4     NORMAL = 'NORMAL',
       }

       -- Validates a bill creation request.
       -- @param params table {
       --   mode, recipeId, primaryOutput, targetQuantity, batchOutputAmount,
       --   createdBy = { type, id },
       -- }
       -- @return boolean ok
       -- @return string|nil reason
       local function validateBillCreation(params)
    12     if type(params) ~= 'table' then
*****0         return false, 'params must be a table'
           end
    12     if params.mode ~= BillMode.PRODUCE_X and params.mode ~= BillMode.MAINTAIN_X then
     2         return false, 'mode must be PRODUCE_X or MAINTAIN_X'
           end
    10     if type(params.recipeId) ~= 'string' or params.recipeId == '' then
*****0         return false, 'recipeId must be a nonempty string'
           end
    10     if type(params.primaryOutput) ~= 'string' or params.primaryOutput == '' then
*****0         return false, 'primaryOutput must be a nonempty string'
           end
    10     if type(params.targetQuantity) ~= 'number'
    10         or params.targetQuantity ~= math.floor(params.targetQuantity)
     8         or params.targetQuantity <= 0 then
     4         return false, 'targetQuantity must be a positive integer'
           end
     6     if type(params.batchOutputAmount) ~= 'number'
     6         or params.batchOutputAmount ~= math.floor(params.batchOutputAmount)
     6         or params.batchOutputAmount <= 0 then
*****0         return false, 'batchOutputAmount must be a positive integer'
           end
           -- PRODUCE_X: target must be a multiple of the batch output amount.
     6     if params.mode == BillMode.PRODUCE_X then
     4         if params.targetQuantity % params.batchOutputAmount ~= 0 then
     4             return false, ('PRODUCE_X target (%d) must be a multiple of batch output (%d)'):format(
     4                 params.targetQuantity, params.batchOutputAmount)
               end
           end
     4     return true
       end

       -- Checks whether a PRODUCE_X bill is complete (produced >= target).
       -- @param bill table { mode, target_quantity, produced_quantity }
       -- @return boolean complete
       local function isProduceXComplete(bill)
    18     return (bill.produced_quantity or 0) >= bill.target_quantity
       end

       -- Checks whether a MAINTAIN_X bill is satisfied.
       -- MAINTAIN_X compares stock + reserved output against the target. It may
       -- exceed the target by at most one batch.
       -- @param bill table { mode, target_quantity }
       -- @param stockPlusReserved number current stock of primaryOutput + reserved output
       -- @param batchOutputAmount number output per batch
       -- @return boolean satisfied
       local function isMaintainXSatisfied(bill, stockPlusReserved, batchOutputAmount)
    10     local available = stockPlusReserved or 0
    10     local target = bill.target_quantity
           -- Satisfied when available >= target. Overshoot by at most one batch is
           -- allowed: the cycle engine must not start a new cycle if
           -- available >= target (even if available < target + batchOutputAmount).
    10     return available >= target
       end

       -- Determines whether a new cycle should start for a bill.
       -- PRODUCE_X: start if not complete (produced < target).
       -- MAINTAIN_X: start if stock + reserved < target (may overshoot by one batch).
       -- @param bill table
       -- @param stockPlusReserved number (for MAINTAIN_X)
       -- @param batchOutputAmount number
       -- @return boolean shouldStart
       local function shouldStartCycle(bill, stockPlusReserved, batchOutputAmount)
    22     if not bill.enabled then
     2         return false
           end
    20     if bill.status == BillStatus.PAUSED or bill.status == BillStatus.REMOVED then
     2         return false
           end
    18     if bill.mode == BillMode.PRODUCE_X then
    14         return not isProduceXComplete(bill)
           end
     4     if bill.mode == BillMode.MAINTAIN_X then
     4         return not isMaintainXSatisfied(bill, stockPlusReserved, batchOutputAmount)
           end
*****0     return false
       end

       -- Computes how many cycles of a recipe can run in a catch-up chunk given the
       -- elapsed time, input availability, output capacity, and bill target.
       -- This is the analytic multi-cycle computation: no per-cycle loops.
       -- @param params table {
       --   recipeDurationSeconds, elapsedSeconds, maxCyclesPerChunk,
       --   inputAvailability = { [item_name] = available_count },
       --   recipeInputs = { { item, amount } },
       --   outputCapacityRemaining = number (grams or units),
       --   outputWeightPerCycle = number,
       --   bill = { mode, target_quantity, produced_quantity } | nil,
       --   batchOutputAmount = number,
       --   stockPlusReserved = number (for MAINTAIN_X),
       -- }
       -- @return number cyclesToRun (0 if blocked)
       -- @return string|nil blockReason
       local function computeCyclesForChunk(params)
    80     if type(params) ~= 'table' then
*****0         return 0, 'params must be a table'
           end

    80     local duration = params.recipeDurationSeconds
    80     local elapsed = params.elapsedSeconds or 0
    80     if type(duration) ~= 'number' or duration <= 0 then
*****0         return 0, 'invalid recipe duration'
           end
    80     if elapsed <= 0 then
     4         return 0, nil  -- zero/negative elapsed: no cycles to run
           end

           -- Time-bound: how many full cycles fit in the elapsed time.
    76     local timeBoundedCycles = math.floor(elapsed / duration)
    76     if timeBoundedCycles <= 0 then
*****0         return 0, nil
           end

           -- Cap by max cycles per chunk.
    76     local maxCycles = params.maxCyclesPerChunk or timeBoundedCycles
    76     if maxCycles < timeBoundedCycles then
    40         timeBoundedCycles = maxCycles
           end

           -- Input-bound: how many cycles can the available inputs support.
    76     local inputBoundedCycles = timeBoundedCycles
    76     if type(params.recipeInputs) == 'table' and type(params.inputAvailability) == 'table' then
   152         for _, line in ipairs(params.recipeInputs) do
    76             local available = params.inputAvailability[line.item] or 0
    76             local cyclesFromThisInput = math.floor(available / line.amount)
    76             if cyclesFromThisInput < inputBoundedCycles then
    10                 inputBoundedCycles = cyclesFromThisInput
                   end
               end
           end
    76     if inputBoundedCycles <= 0 then
     6         return 0, 'insufficient inputs'
           end

           -- Output-capacity-bound: how many cycles fit in the remaining output capacity.
    70     local cycles = inputBoundedCycles
    70     if params.outputWeightPerCycle and params.outputCapacityRemaining then
    70         local outputBoundedCycles = math.floor(params.outputCapacityRemaining / params.outputWeightPerCycle)
    70         if outputBoundedCycles < cycles then
     4             cycles = outputBoundedCycles
               end
           end
    70     if cycles <= 0 then
     4         return 0, 'output cap reached'
           end

           -- Bill-target-bound: don't overshoot the bill target.
    66     local bill = params.bill
    66     if bill then
    18         if bill.mode == BillMode.PRODUCE_X then
     6             local remaining = bill.target_quantity - (bill.produced_quantity or 0)
     6             local batchOutput = params.batchOutputAmount or 1
     6             local billBoundedCycles = math.floor(remaining / batchOutput)
     6             if billBoundedCycles < cycles then
     6                 cycles = billBoundedCycles
                   end
    12         elseif bill.mode == BillMode.MAINTAIN_X then
                   -- MAINTAIN_X: may exceed target by at most one batch.
    12             local target = bill.target_quantity
    12             local stockPlusReserved = params.stockPlusReserved or 0
    12             local batchOutput = params.batchOutputAmount or 1
    12             local remainingToTarget = target - stockPlusReserved
    12             if remainingToTarget <= 0 then
     6                 return 0, 'maintain target already met'
                   end
                   -- Allow up to ceil(remainingToTarget / batchOutput) cycles, which
                   -- permits overshoot by at most one batch.
     6             local billBoundedCycles = math.ceil(remainingToTarget / batchOutput)
     6             if billBoundedCycles < cycles then
     6                 cycles = billBoundedCycles
                   end
               end
           end

    60     if cycles <= 0 then
     2         return 0, 'bill target reached'
           end

    58     return cycles, nil
       end

       -- Selects the next bill to run for a machine from a list of candidate bills.
       -- Stable order: enabled first, then by priority (NORMAL only at v0.1), then
       -- by created_sequence (ascending).
       -- @param bills table list of bill rows
       -- @param stockPlusReservedByItem table { [primary_output] = number } (for MAINTAIN_X)
       -- @param batchOutputByBill table { [bill_id] = number }
       -- @return table|nil selectedBill
       local function selectNextBill(bills, stockPlusReservedByItem, batchOutputByBill)
     6     if type(bills) ~= 'table' then return nil end

     6     local candidates = {}
    20     for _, bill in ipairs(bills) do
    14         if bill.enabled and bill.status ~= BillStatus.PAUSED and bill.status ~= BillStatus.REMOVED then
    10             local batchOutput = batchOutputByBill and batchOutputByBill[bill.bill_id] or 1
    10             local stockPlusReserved = stockPlusReservedByItem and stockPlusReservedByItem[bill.primary_output] or 0
    10             if shouldStartCycle(bill, stockPlusReserved, batchOutput) then
     8                 candidates[#candidates + 1] = bill
                   end
               end
           end

     6     if #candidates == 0 then
     2         return nil
           end

           -- Sort by priority (NORMAL only at v0.1, so this is stable), then by
           -- created_sequence ascending.
     8     table.sort(candidates, function(a, b)
     4         if a.priority ~= b.priority then
*****0             return a.priority < b.priority
               end
     4         return (a.created_sequence or 0) < (b.created_sequence or 0)
           end)

     4     return candidates[1]
       end

       -- Computes the new produced_quantity after completing a cycle for a bill.
       -- @param bill table { mode, produced_quantity }
       -- @param batchOutputAmount number
       -- @return number newProducedQuantity
       local function applyCycleCompletion(bill, batchOutputAmount)
     4     return (bill.produced_quantity or 0) + batchOutputAmount
       end

     4 CZCraft.Bills = {
     4     Mode = BillMode,
     4     Status = BillStatus,
     4     Priority = BillPriority,
     4     validateBillCreation = validateBillCreation,
